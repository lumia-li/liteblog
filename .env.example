# QQ 登录配置（心月互联）
# 从心月互联获取 token
QQ_LOGIN_TOKEN=your_token_here

# QQ 登录成功后的回调地址（需要在心月互联后台配置）
QQ_LOGIN_CALLBACK=https://your-domain.com/api/auth/qq-callback

# 其他配置（如果需要）
# SESSION_SECRET=your_session_secret
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret
# OAUTH_CALLBACK=your_oauth_callback
# OAUTH_BASE=your_oauth_base
