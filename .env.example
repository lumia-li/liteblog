# QQ 登录配置（心月互联）
# 从心月互联获取 token
QQ_XYHULIAN_TOKEN=your_token_here

# QQ 登录成功后的回调地址（需要在心月互联后台配置）
QQ_XYHULIAN_CALLBACK=https://your-domain.com/loginqq

# Google 登录配置
# 从 Google Cloud Console 下载的 OAuth 2.0 客户端凭据
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth 回调地址，必须与 Google Cloud Console 中配置的授权重定向 URI 完全一致
GOOGLE_CALLBACK=https://your-domain.com/oauth2/google

# GitHub 登录配置
# 从 GitHub Settings > Developer settings > OAuth Apps 获取
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub OAuth 回调地址，必须与 GitHub OAuth App 中配置的 Authorization callback URL 完全一致
GITHUB_CALLBACK=https://your-domain.com/oauth2/github

# Microsoft 登录配置
# 从 Azure 门户 > Microsoft Entra ID > 应用注册 获取（客户端凭据）
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Microsoft OAuth 回调地址，必须与 Azure 应用注册中配置的「重定向 URI」完全一致
MICROSOFT_CALLBACK=https://your-domain.com/oauth2/microsoft

# Microsoft 租户：common（个人+工作/学校）、consumers（仅个人）、organizations（仅工作/学校）或租户 ID
MICROSOFT_TENANT=common

# 会话密钥（用于加密签名 session cookie）
SESSION_SECRET=your_random_session_secret_here

# 开发者口令（用于解锁开发者模式 / 文章编辑器 / 登录历史后台）
# 后台地址：/admin （登录历史记录存储于 data/login-history.json，不在 public 目录）
DEV_EDITOR_CODE=your_dev_editor_code_here

# ─── 登录历史存储后端（三选一，按优先级：远程服务器 > Vercel KV > 本地文件） ───

# 1) 远程服务器（推荐：网站跑 Vercel，登录记录存到自己的服务器）
#    服务器上跑一个轻量存储 API，需要鉴权 token。
#    URL 形如 http://你的服务器IP:8700 （不要带尾部斜杠）
LOG_HISTORY_SERVER_URL=
LOG_HISTORY_SERVER_TOKEN=

# 2) Vercel KV（可选：用 Upstash Redis 持久化）
#    在 Vercel 的 Marketplace 安装 Upstash Redis 后会自动注入。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 3) 本地文件（仅本地开发 / 自托管 Node 服务器可用）
#    无需配置，未配置以上两项时自动使用 data/login-history.json。
