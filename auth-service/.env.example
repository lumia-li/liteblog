# ── 服务 ─────────────────────────────────────────────
PORT=4100
# 允许跨域的博客来源（博客走服务端代理，一般不需要浏览器直连，留空即可）
CORS_ORIGIN=

# ── 博客与认证服务之间的内部 API Key（两边必须一致）──
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SERVICE_API_KEY=change-me-to-a-long-random-string

# ── 数据库（MySQL）────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auth
DB_PASSWORD=change-me
DB_NAME=auth
# 连接池大小
DB_POOL_LIMIT=10

# ── SMTP 发信（以 QQ 邮箱为例，密码为授权码而非登录密码）──
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mail@qq.com
SMTP_PASS=your-smtp-auth-code
# 发件人显示，如 "liyue blog <me@liyueovo.top>"（不带地址则默认用 SMTP_USER）
SMTP_FROM_NAME=liyue blog

# ── 业务参数 ─────────────────────────────────────────
# 验证码/链接有效期（分钟）
VERIFY_EXPIRE_MINUTES=15
# 注册后站点上设置密码页地址（邮件链接用）
SITE_URL=https://li.liyueovo.top
# 签发到会话里的内部 token 有效期（天）
SESSION_DAYS=7
# TOTP 种子加密密钥（留空时回退 AUTH_SERVICE_API_KEY；生产建议单独设置）
TOTP_ENCRYPTION_KEY=change-me-to-another-long-random-string
# 身份验证器中显示的发行方名称
TOTP_ISSUER=Liyue Blog

# ── Passkey 通行密钥（WebAuthn）────────────────────────
# Relying Party ID：必须是用户浏览器完成验证仪式的域名（默认取 SITE_URL 主机名，通常无需设置）
# RP_ID=li.liyueovo.top
# 允许的站点来源（默认取 SITE_URL；博客与 SITE_URL 不同域时必须设置，逗号分隔）
# PASSKEY_ORIGINS=https://li.liyueovo.top
# 浏览器弹窗中显示的名称
RP_NAME=liyue blog

# ── 头像存储（服务器本地磁盘）─────────────────────────
# 图片落盘目录（相对启动目录或绝对路径）
AVATAR_DIR=data/avatars
# 头像对外访问地址前缀（浏览器 <img> 直接访问，需经 Nginx 把 /avatars 代理到本服务）
# 例：https://api.liyueovo.top/avatars；留空则用请求 Host 自动推导
AVATAR_PUBLIC_BASE=https://api.liyueovo.top/avatars
