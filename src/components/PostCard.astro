---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const { remarkPluginFrontmatter } = await entry.render();
---

<article class:list={["card-base simple-post-card mb-3 p-5", className]} style={style}>
	<div class="simple-post-head">
		<a href={url} class="simple-post-title" draggable="false">{title}</a>
		<a href={url} class="simple-post-enter" aria-label={title} draggable="false">
			<Icon name="material-symbols:arrow-forward-rounded" class="text-[1.1rem]" />
		</a>
	</div>

	<PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="simple-meta" />

	<div class="simple-post-desc">{description || remarkPluginFrontmatter.excerpt}</div>

	{hasCover && (
		<a href={url} class="simple-post-cover" draggable="false">
			<ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={title} class="w-full h-full" />
		</a>
	)}
</article>

<style>
	.simple-post-card {
		--post-card-bg: #ffffff;
		--post-card-border: #d9d9d9;
		--post-card-border-hover: #cfcfcf;
		--post-card-shadow: 0 10px 26px rgba(26, 26, 26, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.95);
		--post-card-shadow-hover: 0 16px 30px rgba(26, 26, 26, 0.09), inset 0 1px 0 rgba(255, 255, 255, 0.98);
		--post-title: #0e1726;
		--post-title-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
		--post-enter-border: #d6d6d6;
		--post-enter-bg: linear-gradient(180deg, #ffffff 0%, #f0f0f0 100%);
		--post-enter-bg-hover: linear-gradient(180deg, #eef6ff 0%, #ddeeff 100%);
		--post-enter-color: #1b3552;
		--post-enter-color-hover: #0f2d4f;
		--post-enter-shadow: 0 4px 10px rgba(38, 65, 94, 0.12);
		--post-enter-shadow-hover: 0 7px 14px rgba(33, 77, 128, 0.16);
		--post-meta-bg: rgba(233, 238, 244, 0.72);
		--post-meta-border: rgba(173, 188, 205, 0.44);
		--post-meta-text: #213347;
		--post-desc: #394b62;
		--post-cover-border: #d5dde6;
		--post-cover-shadow: 0 8px 16px rgba(24, 36, 49, 0.1);
		position: relative;
		border-radius: 22px !important;
		background: var(--post-card-bg) !important;
		border: 1px solid var(--post-card-border) !important;
		box-shadow: var(--post-card-shadow);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	:global(html.dark) .simple-post-card {
		--post-card-bg: #141b26;
		--post-card-border: #2c384c;
		--post-card-border-hover: #3a4b66;
		--post-card-shadow: 0 14px 28px rgba(2, 6, 23, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.03);
		--post-card-shadow-hover: 0 20px 36px rgba(2, 6, 23, 0.56), inset 0 1px 0 rgba(255, 255, 255, 0.05);
		--post-title: #ebf0fa;
		--post-title-shadow: none;
		--post-enter-border: #30405a;
		--post-enter-bg: linear-gradient(180deg, #1b2534 0%, #151e2c 100%);
		--post-enter-bg-hover: linear-gradient(180deg, #243247 0%, #1e2a3d 100%);
		--post-enter-color: #d6e4ff;
		--post-enter-color-hover: #e7f0ff;
		--post-enter-shadow: 0 8px 14px rgba(2, 6, 23, 0.45);
		--post-enter-shadow-hover: 0 12px 18px rgba(2, 6, 23, 0.52);
		--post-meta-bg: rgba(30, 42, 60, 0.8);
		--post-meta-border: rgba(62, 79, 106, 0.72);
		--post-meta-text: #c9d8ef;
		--post-desc: #b8c7dd;
		--post-cover-border: #31425c;
		--post-cover-shadow: 0 10px 18px rgba(2, 6, 23, 0.46);
	}

	.simple-post-card:hover {
		transform: translateY(-2px);
		background: var(--post-card-bg) !important;
		border-color: var(--post-card-border-hover) !important;
		box-shadow: var(--post-card-shadow-hover);
	}

	.simple-post-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.simple-post-title {
		flex: 1;
		font-size: clamp(1.24rem, 2.2vw, 1.72rem);
		font-weight: 800;
		color: var(--post-title);
		line-height: 1.3;
		letter-spacing: 0.01em;
		text-shadow: var(--post-title-shadow);
	}

	.simple-post-enter {
		height: 36px;
		width: 36px;
		border-radius: 9999px;
		border: 1px solid var(--post-enter-border);
		background: var(--post-enter-bg);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--post-enter-color);
		box-shadow: var(--post-enter-shadow);
		transition:
			transform 0.16s ease,
			background 0.16s ease,
			color 0.16s ease,
			box-shadow 0.16s ease;
	}

	.simple-post-enter:hover {
		background: var(--post-enter-bg-hover);
		color: var(--post-enter-color-hover);
		transform: translateX(1px);
		box-shadow: var(--post-enter-shadow-hover);
	}

	.simple-post-enter:active {
		transform: scale(0.93);
	}

	.simple-meta {
		margin-top: 11px;
		padding: 8px 10px;
		border-radius: 12px;
		background: var(--post-meta-bg);
		border: 1px solid var(--post-meta-border);
	}

	:global(.simple-meta .text-50) {
		color: var(--post-meta-text) !important;
	}

	.simple-post-desc {
		margin-top: 10px;
		color: var(--post-desc);
		font-size: 1.02rem;
		line-height: 1.7;
	}

	.simple-post-cover {
		display: block;
		margin-top: 14px;
		height: 180px;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--post-cover-border);
		box-shadow: var(--post-cover-shadow);
	}
</style>
