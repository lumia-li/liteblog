---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const { remarkPluginFrontmatter } = await entry.render();
---

<article class:list={["card-base simple-post-card mb-3 p-5", className]} style={style}>
	<div class="simple-post-head">
		<a href={url} class="simple-post-title" draggable="false">{title}</a>
		<a href={url} class="simple-post-enter" aria-label={title} draggable="false">
			<Icon name="material-symbols:arrow-forward-rounded" class="text-[1.1rem]" />
		</a>
	</div>

	<PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="simple-meta" />

	<div class="simple-post-desc">{description || remarkPluginFrontmatter.excerpt}</div>

	{hasCover && (
		<a href={url} class="simple-post-cover" draggable="false">
			<ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={title} class="w-full h-full" />
		</a>
	)}
</article>

<style>
	.simple-post-card {
		position: relative;
		border-radius: 22px !important;
		background: #ffffff !important;
		border: 1px solid #d9d9d9 !important;
		box-shadow:
			0 10px 26px rgba(26, 26, 26, 0.06),
			inset 0 1px 0 rgba(255, 255, 255, 0.95);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.simple-post-card:hover {
		transform: translateY(-2px);
		background: #ffffff !important;
		border-color: #cfcfcf !important;
		box-shadow:
			0 16px 30px rgba(26, 26, 26, 0.09),
			inset 0 1px 0 rgba(255, 255, 255, 0.98);
	}

	.simple-post-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.simple-post-title {
		flex: 1;
		font-size: clamp(1.24rem, 2.2vw, 1.72rem);
		font-weight: 800;
		color: #0e1726;
		line-height: 1.3;
		letter-spacing: 0.01em;
		text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
	}

	.simple-post-enter {
		height: 36px;
		width: 36px;
		border-radius: 9999px;
		border: 1px solid #d6d6d6;
		background: linear-gradient(180deg, #ffffff 0%, #f0f0f0 100%);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #1b3552;
		box-shadow: 0 4px 10px rgba(38, 65, 94, 0.12);
		transition:
			transform 0.16s ease,
			background 0.16s ease,
			color 0.16s ease,
			box-shadow 0.16s ease;
	}

	.simple-post-enter:hover {
		background: linear-gradient(180deg, #eef6ff 0%, #ddeeff 100%);
		color: #0f2d4f;
		transform: translateX(1px);
		box-shadow: 0 7px 14px rgba(33, 77, 128, 0.16);
	}

	.simple-meta {
		margin-top: 11px;
		padding: 8px 10px;
		border-radius: 12px;
		background: rgba(233, 238, 244, 0.72);
		border: 1px solid rgba(173, 188, 205, 0.44);
	}

	:global(.simple-meta .text-50) {
		color: #213347 !important;
	}

	.simple-post-desc {
		margin-top: 10px;
		color: #394b62;
		font-size: 1.02rem;
		line-height: 1.7;
	}

	.simple-post-cover {
		display: block;
		margin-top: 14px;
		height: 180px;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid #d5dde6;
		box-shadow: 0 8px 16px rgba(24, 36, 49, 0.1);
	}
</style>
