			<p class="hero-control-menu-title">开发者模式</p>
		</div>
		<input
			type="password"
			class="hero-decrypt-input"
			placeholder="输入开发口令，按回车解锁"
			data-decrypt-input
			autocomplete="off"
			spellcheck="false"
		/>
		<div class="hero-decrypt-output" data-decrypt-output>等待输入</div>
	</div>
</div>

<script is:inline>
	(() => {
		const LIGHT_MODE = "light";
		const DARK_MODE = "dark";
		const root = document.documentElement;
		const host = window;
		const CAPSULE_SELECTOR = "[data-home-capsule]";
		const DEV_EDITOR_ENABLED_KEY = "devEditorEnabled";
		const DEV_EDITOR_CREDENTIAL_STORAGE_KEY = "devEditorCredential";
		const DEV_EDITOR_LEGACY_CODE_STORAGE_KEY = "devEditorCode";
		const DEV_EDITOR_AUTO_LOCK_AT_KEY = "devEditorAutoLockAt";
		const DEV_EDITOR_SESSION_KEY = "devEditorSessionActive";
		const DEV_EDITOR_SESSION_GRACE_UNTIL_KEY = "devEditorSessionGraceUntil";
		const DEV_EDITOR_SESSION_RECOVERY_GRACE_MS = 30 * 1000;

		const hashDevCodeClient = async (code) => {
			if (typeof crypto === "undefined" || typeof crypto.subtle === "undefined") {
				throw new Error("当前环境不支持口令加密");
			}
			const input = new TextEncoder().encode(code);
			const digest = await crypto.subtle.digest("SHA-256", input);
			return Array.from(new Uint8Array(digest), (byte) =>
				byte.toString(16).padStart(2, "0"),
			).join("");
		};

		const enableDeveloperMode = (devCodeHash) => {
			localStorage.setItem(DEV_EDITOR_CREDENTIAL_STORAGE_KEY, devCodeHash);
			localStorage.removeItem(DEV_EDITOR_LEGACY_CODE_STORAGE_KEY);
			localStorage.setItem(DEV_EDITOR_ENABLED_KEY, "true");
			localStorage.removeItem(DEV_EDITOR_AUTO_LOCK_AT_KEY);
			localStorage.setItem(
				DEV_EDITOR_SESSION_GRACE_UNTIL_KEY,
				String(Date.now() + DEV_EDITOR_SESSION_RECOVERY_GRACE_MS),
			);
			try {
				sessionStorage.setItem(DEV_EDITOR_SESSION_KEY, "true");
			} catch (_error) {
				// Ignore storage exceptions and fail open for this UX action.
			}
			window.dispatchEvent(
				new CustomEvent("developer-mode-change", { detail: true }),
			);
		};

		const unlockDeveloperMode = async (rawCode) => {
			const source = String(rawCode || "").trim();
			if (!source) {
				return "请输入开发者口令";
			}

			let devCodeHash = "";
			try {
				devCodeHash = await hashDevCodeClient(source);
			} catch (error) {
				const message =
					error instanceof Error ? error.message : "口令加密失败，请稍后再试";
				return message;
			}

			try {
				const response = await fetch("/api/dev/verify", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({ devCodeHash }),
					cache: "no-store",
				});
				if (!response.ok) {
					return response.status === 403
						? "口令错误，开发者模式解锁失败"
						: "校验失败，请稍后重试";
				}
				enableDeveloperMode(devCodeHash);
				return "开发者模式已解锁，可使用编辑器/草稿箱/垃圾桶";
			} catch {
				return "网络异常，暂时无法验证口令";
			}
		};

		const reflectThemeState = (capsule) => {
			if (!(capsule instanceof HTMLElement)) return;
			const isDark = root.classList.contains("dark");
			capsule.dataset.mode = isDark ? DARK_MODE : LIGHT_MODE;
			const toggle = capsule.querySelector("[data-theme-toggle]");
			if (toggle instanceof HTMLButtonElement) {
				toggle.setAttribute("aria-pressed", String(isDark));
			}
		};

		const setThemeFromCapsule = (mode) => {
			const nextMode = mode === DARK_MODE ? DARK_MODE : LIGHT_MODE;
			const apply = () => {
				root.classList.toggle("dark", nextMode === DARK_MODE);
				root.setAttribute("data-theme", nextMode === DARK_MODE ? "github-dark" : "github-light");
				localStorage.setItem("theme", nextMode);
				const capsule = document.querySelector(CAPSULE_SELECTOR);
				reflectThemeState(capsule);
			};

			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const doc = document;
			if (!prefersReducedMotion && typeof doc.startViewTransition === "function") {
				try {
					const transition = doc.startViewTransition(apply);
					transition.finished?.catch(() => {});
				} catch {
					apply();
				}
				return;
			}

			root.classList.add("theme-switching-soft");
			apply();
			window.setTimeout(() => {
				root.classList.remove("theme-switching-soft");
			}, 360);
		};

		const closeMenu = (capsule) => {
			if (!(capsule instanceof HTMLElement)) return;
			const menu = capsule.querySelector("[data-control-menu]");
			const toggle = capsule.querySelector("[data-menu-toggle]");
			if (menu instanceof HTMLElement) {
				menu.hidden = true;
			}
			if (toggle instanceof HTMLButtonElement) {
				toggle.setAttribute("aria-expanded", "false");
			}
			capsule.classList.remove("menu-open");
		};

		const toggleMenu = (capsule) => {
			if (!(capsule instanceof HTMLElement)) return;
			const menu = capsule.querySelector("[data-control-menu]");
			const toggle = capsule.querySelector("[data-menu-toggle]");
			if (!(menu instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
			const nextOpen = menu.hidden;
			menu.hidden = !nextOpen;
			toggle.setAttribute("aria-expanded", String(nextOpen));
			capsule.classList.toggle("menu-open", nextOpen);
		};

		const setupCapsule = () => {
			const capsule = document.querySelector(CAPSULE_SELECTOR);
			if (!(capsule instanceof HTMLElement) || capsule.dataset.bound === "true") return;
			capsule.dataset.bound = "true";
			reflectThemeState(capsule);

			const themeToggle = capsule.querySelector("[data-theme-toggle]");
			const menuToggle = capsule.querySelector("[data-menu-toggle]");
			const decryptInput = capsule.querySelector("[data-decrypt-input]");
			const decryptOutput = capsule.querySelector("[data-decrypt-output]");
			let decrypting = false;

			if (themeToggle instanceof HTMLButtonElement) {
				themeToggle.addEventListener("click", () => {
					const nextMode = root.classList.contains("dark") ? LIGHT_MODE : DARK_MODE;
					setThemeFromCapsule(nextMode);
				});
			}

			if (menuToggle instanceof HTMLButtonElement) {
				menuToggle.addEventListener("click", (event) => {
					event.preventDefault();
					toggleMenu(capsule);
					if (
						menuToggle.getAttribute("aria-expanded") === "true" &&
						decryptInput instanceof HTMLInputElement
					) {
						window.setTimeout(() => decryptInput.focus(), 0);
					}
				});
			}

			const runDecrypt = async () => {
				if (
					decrypting ||
					!(decryptOutput instanceof HTMLElement) ||
					!(decryptInput instanceof HTMLInputElement)
				) {
					return;
				}
				const value = decryptInput.value;
				decrypting = true;
				decryptOutput.dataset.state = "loading";
				decryptOutput.textContent = "正在验证口令...";
				try {
					const message = await unlockDeveloperMode(value);
					const unlocked = message.includes("已解锁");
					decryptOutput.dataset.state = unlocked ? "success" : "error";
					decryptOutput.textContent = message;
					if (unlocked) {
						decryptInput.value = "";
					}
				} catch (_error) {
					decryptOutput.dataset.state = "error";
					decryptOutput.textContent = "校验异常，请稍后重试";
				} finally {
					decrypting = false;
				}
			};

			if (decryptInput instanceof HTMLInputElement) {
				decryptInput.addEventListener("keydown", (event) => {
					if (event.key === "Enter" && !event.isComposing) {
						event.preventDefault();
						runDecrypt();
					}
				});
				decryptInput.addEventListener("input", () => {
					if (!(decryptOutput instanceof HTMLElement)) return;
					if (decryptOutput.dataset.state === "loading") return;
					decryptOutput.dataset.state = "idle";
					decryptOutput.textContent = "回车验证开发口令";
				});
			}
		};

		if (!host.__homeCapsuleOutsideBound) {
			host.__homeCapsuleOutsideBound = true;
			document.addEventListener("pointerdown", (event) => {
				const capsule = document.querySelector(CAPSULE_SELECTOR);
				if (!(capsule instanceof HTMLElement)) return;
				if (event.target instanceof Node && capsule.contains(event.target)) return;
				closeMenu(capsule);
			});
			document.addEventListener("keydown", (event) => {
				if (event.key !== "Escape") return;
				const capsule = document.querySelector(CAPSULE_SELECTOR);
				closeMenu(capsule);
			});
		}

		setupCapsule();

		if (window.swup?.hooks && !host.__homeCapsuleSwupHooked) {
			host.__homeCapsuleSwupHooked = true;
			window.swup.hooks.on("page:view", () => {
				setupCapsule();
			});
		} else if (!window.swup?.hooks && !host.__homeCapsuleSwupEnableBound) {
			host.__homeCapsuleSwupEnableBound = true;
			document.addEventListener(
				"swup:enable",
				() => {
					if (!window.swup?.hooks || host.__homeCapsuleSwupHooked) return;
					host.__homeCapsuleSwupHooked = true;
					window.swup.hooks.on("page:view", () => {
						setupCapsule();
					});
				},
				{ once: true },
			);
		}
	})();
</script>

<style>
	.hero-control-capsule {
		--capsule-bg: rgba(255, 255, 255, 0.76);
		--capsule-border: rgba(205, 213, 224, 0.95);
		--capsule-shadow: 0 12px 32px rgba(18, 25, 39, 0.12);
		--capsule-text: #1d2838;
		--capsule-btn-hover: rgba(28, 39, 56, 0.08);
		--capsule-menu-bg: rgba(255, 255, 255, 0.96);
		--capsule-menu-border: rgba(214, 222, 233, 0.95);
		--capsule-input-bg: #f8fafc;
		--capsule-input-border: #d6deea;
		--capsule-input-text: #1f2937;
		--capsule-output-bg: #f2f5fa;
		--capsule-output-text: #2f3d4d;
		--capsule-accent: #2f9d5b;
		--capsule-marker: #111111;
		--capsule-status-loading-bg: #eef4ff;
		--capsule-status-loading-text: #3b4f76;
		--capsule-status-success-bg: #edf9f1;
		--capsule-status-success-text: #166534;
		--capsule-status-error-bg: #fff1f1;
		--capsule-status-error-text: #b42318;
		position: fixed;
		top: max(14px, calc(env(safe-area-inset-top) + 8px));
		right: max(16px, calc(env(safe-area-inset-right) + 8px));
		z-index: 80;
		display: inline-flex;
		align-items: center;
		gap: 2px;
		padding: 4px;
		border-radius: 999px;
		border: 1px solid var(--capsule-border);
		background: var(--capsule-bg);
		box-shadow: var(--capsule-shadow);
		backdrop-filter: blur(14px) saturate(140%);
	}

	:global(html.dark) .hero-control-capsule {
		--capsule-bg: rgba(15, 20, 29, 0.74);
		--capsule-border: rgba(58, 72, 94, 0.9);
		--capsule-shadow: 0 14px 36px rgba(1, 5, 16, 0.55);
		--capsule-text: #edf2ff;
		--capsule-btn-hover: rgba(237, 242, 255, 0.12);
		--capsule-menu-bg: rgba(15, 21, 32, 0.95);
		--capsule-menu-border: rgba(57, 73, 97, 0.95);
		--capsule-input-bg: #121c2b;
		--capsule-input-border: #30405a;
		--capsule-input-text: #e5ecf8;
		--capsule-output-bg: #101a28;
		--capsule-output-text: #d9e2f2;
		--capsule-accent: #6ad59b;
		--capsule-marker: #edf2ff;
		--capsule-status-loading-bg: rgba(80, 120, 205, 0.24);
		--capsule-status-loading-text: #d4e3ff;
		--capsule-status-success-bg: rgba(34, 197, 94, 0.22);
		--capsule-status-success-text: #bbf7d0;
		--capsule-status-error-bg: rgba(248, 113, 113, 0.2);
		--capsule-status-error-text: #fecaca;
	}

	.hero-control-btn {
		position: relative;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		color: var(--capsule-text);
		cursor: pointer;
		transition: background-color 0.2s ease, transform 0.2s ease;
	}

	.hero-control-btn:hover {
		background: var(--capsule-btn-hover);
	}

	.hero-control-btn:active {
		transform: scale(0.95);
	}

	.hero-control-divider {
		width: 1px;
		height: 20px;
		background: color-mix(in oklab, var(--capsule-text) 25%, transparent);
	}

	.hero-theme-toggle {
		overflow: hidden;
	}

	.hero-theme-icon {
		position: absolute;
		width: 19px;
		height: 19px;
		fill: currentColor;
		transition: opacity 0.24s ease, transform 0.24s ease;
	}

	.hero-control-capsule[data-mode="light"] .hero-theme-icon-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.hero-control-capsule[data-mode="light"] .hero-theme-icon-moon {
		opacity: 0;
		transform: rotate(35deg) scale(0.72);
	}

	.hero-control-capsule[data-mode="dark"] .hero-theme-icon-sun {
		opacity: 0;
		transform: rotate(-35deg) scale(0.72);
	}

	.hero-control-capsule[data-mode="dark"] .hero-theme-icon-moon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.hero-menu-icon {
		width: 20px;
		height: 20px;
		fill: currentColor;
	}

	.hero-control-menu {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		width: min(92vw, 286px);
		padding: 12px 12px 10px;
		border-radius: 14px;
		border: 1px solid var(--capsule-menu-border);
		background: var(--capsule-menu-bg);
		box-shadow: 0 14px 28px rgba(2, 6, 23, 0.28);
		display: flex;
		flex-direction: column;
		gap: 8px;
		text-align: left;
	}

	.hero-control-menu[hidden] {
		display: none;
	}

	.hero-dev-header {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.hero-dev-dot {
		width: 5px;
		height: 18px;
		border-radius: 9999px;
		background: var(--capsule-marker);
		box-shadow: none;
	}

	.hero-control-menu-title {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--capsule-text);
	}

	.hero-decrypt-input {
		width: 100%;
		height: 40px;
		padding: 0 12px;
		border-radius: 10px;
		border: 1px solid var(--capsule-input-border);
		background: var(--capsule-input-bg);
		color: var(--capsule-input-text);
		font-size: 0.84rem;
		line-height: 40px;
		outline: none;
		caret-color: var(--capsule-accent);
	}

	.hero-decrypt-input::placeholder {
		color: color-mix(in oklab, var(--capsule-input-text) 64%, transparent);
	}

