---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import Lantern from "@components/widget/Lantern.svelte";
import RainEffect from "@components/widget/RainEffect.svelte";
import { getBannerOffset } from "@utils/banner-utils";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";
import "../styles/transition.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	pageType?: string;
}

let { title, banner, description, lang, setOGTypeArticle, pageType } =
	Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
const isHubPageType = pageType === "hub";

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffset = getBannerOffset(siteConfig.banner.position);
const homeBannerHeight = "52vh";
const customFontHref = url("/fonts/KeinannMaruPOP_CN-EN.ttf");
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="preload"
			as="font"
			href={customFontHref}
			type="font/ttf"
			crossorigin
		/>
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script
			is:inline
			define:vars={{ DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, configHue }}
		>
			const root = document.documentElement;
			const theme = localStorage.getItem("theme") || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					root.classList.remove("dark");
					break;
				case DARK_MODE:
					root.classList.add("dark");
					break;
				case AUTO_MODE:
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						root.classList.add("dark");
					} else {
						root.classList.remove("dark");
					}
					break;
			}

			const hue = localStorage.getItem("hue") || configHue;
			root.style.setProperty("--hue", hue);

			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - (offset % 4);
			root.style.setProperty("--banner-height-extend", `${offset}px`);
		</script>
		<script is:inline>
			// Prevent browser scroll restoration from causing refresh-time layout jumps.
			try {
				if ("scrollRestoration" in history) history.scrollRestoration = "manual";
			} catch {}
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>
		<script defer src="https://u.liyueovo.top/script.js" data-website-id="a9f4f1e3-607d-430e-842f-eb9e6e65aca4"></script>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		data-page-type={pageType}
		data-overlayscrollbars-initialize
	>

		<ConfigCarrier></ConfigCarrier>
		{!isHubPageType && <Lantern client:load />}
		{!isHubPageType && <RainEffect client:load />}
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>

		
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
	'home-banner-height-custom': homeBannerHeight,
}}>
@font-face {
	font-family: "KeinannMaruPOP";
	src: url("/fonts/KeinannMaruPOP_CN-EN.ttf") format("truetype");
	font-display: swap;
}

@tailwind components;
@layer components {
	.enable-banner {
		--main-panel-top: calc(var(--banner-height) - 3.5rem);
	}
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--home-banner-height-custom)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--home-banner-height-custom)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		transform: translateY(calc(var(--banner-height-extend) - 5.5rem));
		position: relative;
		isolation: isolate;
	}
	/* 移除 main-grid 遮罩层 */
	.enable-banner.is-home #main-grid::before {
		content: none;
	}
	.enable-banner.is-home #main-grid > * {
		position: relative;
		z-index: 1;
	}
	/* 移除 banner 遮罩层，保持图片完全清晰可见 */
	.enable-banner.is-home #banner-wrapper::after {
		content: none;
	}
	.enable-banner.is-home #top-row {
		height: calc(var(--home-banner-height-custom) - 4.5rem);
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.enable-banner.is-home #content-wrapper {
		padding-bottom: 1.5rem;
	}
	.enable-banner.is-home #main-grid.home-main-grid #sidebar {
		margin-top: -1.9rem;
	}
	.enable-banner.is-home #main-grid.home-main-grid #profile-card {
		box-shadow:
			0 28px 56px -34px rgba(0, 0, 0, 0.72),
			0 0 0 1px rgba(255, 255, 255, 0.04);
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}

</style>

