const isBannerEnabled = () => document.body?.classList?.contains('enable-banner');

function setClickOutsideToClose(panel: string, ignores: string[]) {
	const isIgnoredTarget = (target: Node | null) => {
		if (!(target instanceof Node)) return false;
		for (let ig of ignores) {
			let ie = document.getElementById(ig);
			if (ie == target || ie?.contains(target)) {
				return true;
			}
		}
		return false;
	};

	let pointerStartedInside = false;

	document.addEventListener("pointerdown", event => {
		pointerStartedInside = isIgnoredTarget(event.target);
	});

	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;
		if (isIgnoredTarget(tDom) || pointerStartedInside) {
			pointerStartedInside = false;
			return;
		}
		pointerStartedInside = false;
		panelDom?.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

let postNavScrollHandlerBound = false;
let postNavTransitionRunning = false;
let postNavVisitPending = false;

function animateScrollToTop(duration: number) {
	return new Promise<void>((resolve) => {
		const startY = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
		if (startY <= 4 || duration <= 0) {
			window.scrollTo(0, 0);
			resolve();
			return;
		}

		const startTime = performance.now();
		const easeInOutCubic = (t: number) => (
			t < 0.5
				? 4 * t * t * t
				: 1 - ((-2 * t + 2) ** 3) / 2
		);

		const tick = (now: number) => {
			const progress = Math.min(1, (now - startTime) / duration);
			const eased = easeInOutCubic(progress);
			const nextY = Math.max(0, Math.round(startY * (1 - eased)));
			window.scrollTo(0, nextY);

			if (progress < 1) {
				requestAnimationFrame(tick);
				return;
			}

			window.scrollTo(0, 0);
			resolve();
		};

		requestAnimationFrame(tick);
	});
}

function initPostNavScrollTransition() {
	if (postNavScrollHandlerBound) return;
	postNavScrollHandlerBound = true;

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const link = target.closest("a[data-post-nav-link='true']");
		if (!(link instanceof HTMLAnchorElement)) return;
		if (!link.href || link.getAttribute("href") === "#") return;
		if (
			event.defaultPrevented ||
			event.button !== 0 ||
			link.target === "_blank" ||
			event.metaKey ||
			event.ctrlKey ||
			event.shiftKey ||
			event.altKey
		) {
			return;
		}
		if (postNavTransitionRunning) {
			event.preventDefault();
			return;
		}

		event.preventDefault();
		postNavTransitionRunning = true;
		postNavVisitPending = true;

		const currentY = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
		const duration = Math.min(760, Math.max(300, currentY * 0.2));
		document.documentElement.classList.add("post-nav-scrolling");
		document.documentElement.style.setProperty("--content-delay", "0ms");

		animateScrollToTop(duration)
			.catch(() => {})
			.finally(() => {
				document.documentElement.classList.remove("post-nav-scrolling");
				document.documentElement.classList.add("post-nav-visit");
				const href = link.href;
				if (window?.swup?.navigate) {
					window.swup.navigate(href);
				} else {
					window.location.href = href;
				}
				window.setTimeout(() => {
					postNavTransitionRunning = false;
				}, 120);
			});
	}, { passive: false, capture: true });
}

function initCustomScrollbar() {
	// Hub homepage uses a bespoke static layout; body-level scrollbar enhancement
	// can trigger measurable refresh-time reflow/jitter there.
	if (document.body?.dataset?.pageType === "hub") return;

	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	OverlayScrollbars(
		// docs say that a initialization to the body element would affect native functionality like window.scrollTo
		// but just leave it here for now
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 500,
			autoHideSuspend: false,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('aria-label', 'scrollable container for formulas');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		OverlayScrollbars(container, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-auto',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});

		element.setAttribute('data-scrollbar-initialized', 'true');
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
			processKatexElement(entry.target as HTMLElement);
			observer.unobserve(entry.target);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

const AVATAR_BANNER_CUT_RATIO = 2 / 3;

function syncHomeBannerHeightToAvatar() {
	if (typeof window !== "undefined" && window.__bannerToggleInProgress) {
		return;
	}

	const root = document.documentElement;
	const body = document.body;

	// Only adjust on the homepage where the profile avatar exists.
	if (!body?.classList?.contains("lg:is-home")) {
		root.style.removeProperty("--home-banner-height-custom");
		return;
	}

	const bannerWrapper = document.getElementById("banner-wrapper");
	const avatar = document.querySelector("#profile-card .profile-avatar-frame");
	if (!(bannerWrapper instanceof HTMLElement) || !(avatar instanceof HTMLElement)) {
		return;
	}

	const bannerRect = bannerWrapper.getBoundingClientRect();
	const avatarRect = avatar.getBoundingClientRect();

	const bannerTop = bannerRect.top + window.scrollY;
	const avatarTop = avatarRect.top + window.scrollY;
	const desiredBottom = avatarTop + avatarRect.height * AVATAR_BANNER_CUT_RATIO;

	let desiredHeight = desiredBottom - bannerTop;
	if (!Number.isFinite(desiredHeight)) return;
	desiredHeight = Math.max(0, desiredHeight);
	// Snap to a multiple of 4px to avoid blurry edges on some displays.
	desiredHeight = desiredHeight - (desiredHeight % 4);

	root.style.setProperty("--home-banner-height-custom", `${desiredHeight}px`);
}

function showBanner() {
	if (!isBannerEnabled()) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
	syncHomeBannerHeightToAvatar();
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	initCustomScrollbar();
	initPostNavScrollTransition();
	showBanner();
	if (document.body?.dataset?.pageType === "hub") {
		window.scrollTo(0, 0);
	}
}

window.addEventListener("banner-enabled-updated", () => {
	requestAnimationFrame(() => {
		showBanner();
		requestAnimationFrame(() => {
			syncHomeBannerHeightToAvatar();
			scrollFunction();
		});
	});
});

/* Load settings when entering the site */
init();

const setup = () => {
	const toPathname = (rawUrl: string) => {
		try {
			return new URL(rawUrl, window.location.origin).pathname;
		} catch {
			return rawUrl;
		}
	};
	const syncHomeCenteredState = (isHome: boolean) => {
		const shellElement = document.querySelector(".hub-shell");
		if (shellElement instanceof HTMLElement) {
			shellElement.classList.toggle("home-centered", isHome);
		}
		const swupContainer = document.getElementById("swup-container");
		if (swupContainer instanceof HTMLElement) {
			swupContainer.classList.toggle("home-centered", isHome);
		}
	};

	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!isBannerEnabled()) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('content:replace', initCustomScrollbar)
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		const targetPathname = toPathname(visit.to.url);
		const isTargetHome = pathsEqual(targetPathname, url('/'));
		if (isTargetHome) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}
		syncHomeCenteredState(isTargetHome);

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}

	});
	window.swup.hooks.on('page:view', () => {
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.add('hidden')
		}

        // Reset all onload animations
        const isPostNavVisit = postNavVisitPending || document.documentElement.classList.contains('post-nav-visit');
        if (!isPostNavVisit) {
            const animatedElements = document.querySelectorAll('.onload-animation');
            animatedElements.forEach((element) => {
                if (!(element instanceof HTMLElement)) return;
                element.style.animation = 'none';
                void element.offsetHeight; // Force reflow
                element.style.animation = '';
            });
        } else {
            document.documentElement.style.setProperty('--content-delay', '0ms');
        }

        // Just make the transition looks better
        const toc = document.getElementById('toc-wrapper');
        if (toc) {
            toc.classList.remove('toc-not-ready')
        }

        // Re-initialize layout-dependent components
		const isCurrentHome = pathsEqual(window.location.pathname, url('/'));
		syncHomeCenteredState(isCurrentHome);
		if (isCurrentHome) {
			window.scrollTo(0, 0);
			window.requestAnimationFrame(() => {
				syncHomeBannerHeightToAvatar();
			});
		}
        initCustomScrollbar();
        showBanner();
		scrollFunction();
		if (isPostNavVisit) {
			postNavVisitPending = false;
			window.requestAnimationFrame(() => {
				document.documentElement.classList.remove('post-nav-visit');
			});
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		// No need for setTimeout here, handled in page:view
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)
	const backToTopShowOffset = 260
	const isPostNavTransitionActive =
		document.documentElement.classList.contains('post-nav-scrolling') ||
		document.documentElement.classList.contains('post-nav-visit');
	const isPostPage = window.location.pathname.includes('/posts/')
	backToTopBtn = document.getElementById('back-to-top-btn');

	if (backToTopBtn) {
		if (document.body.scrollTop > backToTopShowOffset || document.documentElement.scrollTop > backToTopShowOffset) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (isBannerEnabled() && toc) {
		if (isPostPage) {
			toc.classList.remove('toc-hide')
		} else if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			toc.classList.remove('toc-hide')
		} else {
			toc.classList.add('toc-hide')
		}
	}

	if (!isBannerEnabled()) return
	if (navbar) {
		if (isPostNavTransitionActive) {
			navbar.classList.remove('navbar-hidden')
			return
		}
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner

		let bannerHeight = BANNER_HEIGHT
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			bannerHeight = BANNER_HEIGHT_HOME
		}
		let threshold = window.innerHeight * (bannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		} else {
			navbar.classList.remove('navbar-hidden')
		}
	}
}
window.onscroll = scrollFunction

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
	window.requestAnimationFrame(() => syncHomeBannerHeightToAvatar());
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>

<script>
const PRESS_SELECTOR = 'button:not(:disabled), a[href], [role="button"]';
const PRESS_CLASS = "press-feedback-active";
const RELEASE_DELAY_MS = 110;

const pressReleaseTimers = new WeakMap<HTMLElement, number>();
let activePressTarget: HTMLElement | null = null;
const pressWindow = window as Window & { __pressFeedbackBound?: boolean };

function findPressTarget(target: EventTarget | null): HTMLElement | null {
	if (!(target instanceof Element)) return null;
	const el = target.closest(PRESS_SELECTOR);
	if (!(el instanceof HTMLElement)) return null;
	if (el.getAttribute("aria-disabled") === "true") return null;
	if (el.classList.contains("disabled")) return null;
	return el;
}

function applyPressState(el: HTMLElement) {
	const oldTimer = pressReleaseTimers.get(el);
	if (oldTimer) {
		window.clearTimeout(oldTimer);
		pressReleaseTimers.delete(el);
	}
	el.classList.add(PRESS_CLASS);
	el.style.setProperty("transform", "translateY(1px) scale(0.94)", "important");
	el.style.setProperty("filter", "brightness(0.94)", "important");
}

function clearPressState(el: HTMLElement | null) {
	if (!el) return;
	el.classList.remove(PRESS_CLASS);
	el.style.removeProperty("transform");
	el.style.removeProperty("filter");
}

function releasePressState(el: HTMLElement | null) {
	if (!el) return;
	const oldTimer = pressReleaseTimers.get(el);
	if (oldTimer) window.clearTimeout(oldTimer);
	const timer = window.setTimeout(() => {
		clearPressState(el);
		pressReleaseTimers.delete(el);
		if (activePressTarget === el) {
			activePressTarget = null;
		}
	}, RELEASE_DELAY_MS);
	pressReleaseTimers.set(el, timer);
}

function bindPressFeedback() {
	if (pressWindow.__pressFeedbackBound) return;
	pressWindow.__pressFeedbackBound = true;

	document.addEventListener("pointerdown", (event) => {
		const target = findPressTarget(event.target);
		if (!target) return;
		if (activePressTarget && activePressTarget !== target) {
			clearPressState(activePressTarget);
		}
		activePressTarget = target;
		applyPressState(target);
	}, true);

	document.addEventListener("pointerup", () => {
		releasePressState(activePressTarget);
	}, true);

	document.addEventListener("pointercancel", () => {
		releasePressState(activePressTarget);
	}, true);

	document.addEventListener("dragstart", () => {
		releasePressState(activePressTarget);
	}, true);

	window.addEventListener("blur", () => {
		clearPressState(activePressTarget);
		activePressTarget = null;
	});

	document.addEventListener("visibilitychange", () => {
		if (document.hidden) {
			clearPressState(activePressTarget);
			activePressTarget = null;
		}
	});
}

bindPressFeedback();
</script>
