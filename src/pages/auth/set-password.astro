---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import SetPasswordForm from "@components/auth/SetPasswordForm.svelte";

export const prerender = false;

const token = Astro.url.searchParams.get("token") || "";
---

<MainGridLayout title="设置密码" description="邮箱注册设置密码" showHero={false}>
	<SetPasswordForm client:only="svelte" token={token} />
</MainGridLayout>
