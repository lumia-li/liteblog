---
// QQ 登录回调中转页面
// 心月互联回调地址：https://li.liyueovo.top/loginqq?code=xxx&msg=xxx
// 将请求转发到 /api/auth/qq-callback 处理
const { searchParams } = Astro.url;
const code = searchParams.get("code");
const msg = searchParams.get("msg");

// 如果有 code 参数，重定向到 API 处理
if (code) {
  const params = new URLSearchParams();
  params.set("code", code);
  if (msg) params.set("msg", msg);
  const redirectUrl = `/api/auth/qq-callback?${params.toString()}`;
  console.log("QQ 登录回调重定向:", redirectUrl);
  return Astro.redirect(redirectUrl);
}
---

<html>
<head>
  <meta charset="utf-8">
  <title>QQ 登录</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .container {
      text-align: center;
      padding: 2rem;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }
    h1 {
      margin: 0 0 1rem;
      font-size: 1.5rem;
    }
    p {
      margin: 0;
      opacity: 0.9;
    }
    .error {
      background: rgba(255, 0, 0, 0.2);
      padding: 1rem;
      border-radius: 8px;
      margin-top: 1rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>QQ 登录</h1>
    {!code ? (
      <div class="error">
        <p>缺少登录凭证，请重新尝试登录。</p>
        <p><a href="/" style="color: white;">返回首页</a></p>
      </div>
    ) : (
      <p>正在处理登录，请稍候...</p>
    )}
  </div>
</body>
</html>
