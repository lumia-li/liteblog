---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { readSession } from "@utils/auth-server";

export const prerender = false;

const session = readSession(Astro.request);
const user = session?.user ?? null;
---

<MainGridLayout title="个人资料" description="用户个人资料页" showHero={false}>
	<div class="profile-card">
		{user ? (
			<>
				<div class="profile-header">
					{user.avatar_url ? (
						<img src={user.avatar_url} alt={user.display_name || user.username} class="profile-avatar" />
					) : (
						<div class="profile-avatar profile-avatar-fallback">
							{(user.display_name || user.username).charAt(0).toUpperCase()}
						</div>
					)}
					<div class="profile-titles">
						<h1 class="profile-name">{user.display_name || user.username}</h1>
						<p class="profile-username">@{user.username}</p>
						<span class="profile-role">{user.role === "admin" ? "管理员" : "普通用户"}</span>
					</div>
				</div>
				<div class="profile-body">
					<div class="profile-field">
						<span class="profile-label">用户 ID</span>
						<span class="profile-value">{user.id}</span>
					</div>
					<div class="profile-field">
						<span class="profile-label">邮箱</span>
						<span class="profile-value">{user.email}</span>
					</div>
					<div class="profile-field">
						<span class="profile-label">用户名</span>
						<span class="profile-value">{user.username}</span>
					</div>
				</div>
				<div class="profile-actions">
					<a href="/" class="profile-btn profile-btn-default">返回首页</a>
					<a href="/api/auth/logout" class="profile-btn profile-btn-danger">退出登录</a>
				</div>
			</>
		) : (
			<div class="profile-guest">
				<div class="profile-avatar profile-avatar-fallback">?</div>
				<h1 class="profile-name">未登录</h1>
				<p class="profile-hint">登录后查看你的个人资料</p>
				<div class="profile-guest-actions">
					<a href="/" class="profile-btn profile-btn-default">返回首页</a>
					<a href="/api/auth/login" class="profile-btn profile-btn-primary">使用 Airliny 登录</a>
				</div>
			</div>
		)}
	</div>
</MainGridLayout>

<style>
	.profile-card {
		width: min(100%, 520px);
		margin: 2rem auto 0;
		padding: 1.5rem;
		border-radius: 1.25rem;
		background: var(--surface-bg, #f4f4f4);
		border: 1px solid var(--surface-border, #dddddd);
	}

	.profile-header {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.profile-avatar {
		width: 80px;
		height: 80px;
		border-radius: 999px;
		object-fit: cover;
		background: var(--btn-regular-bg, #f7f7f7);
		border: 1px solid var(--surface-border, #dddddd);
	}

	.profile-avatar-fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		font-weight: 700;
		color: var(--text-color, #111111);
	}

	.profile-titles {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.profile-name {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-color, #111111);
	}

	.profile-username {
		margin: 0;
		font-size: 0.9rem;
		color: color-mix(in oklab, var(--text-color, #111111) 68%, transparent);
	}

	.profile-role {
		display: inline-flex;
		width: fit-content;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		background: var(--btn-regular-bg, #f7f7f7);
		color: var(--text-color, #111111);
		border: 1px solid var(--surface-border, #dddddd);
	}

	.profile-body {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.profile-field {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1rem;
		border-radius: 0.85rem;
		background: var(--card-bg, #f5f5f5);
		border: 1px solid var(--surface-border, #dddddd);
	}

	.profile-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: color-mix(in oklab, var(--text-color, #111111) 72%, transparent);
	}

	.profile-value {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-color, #111111);
		word-break: break-all;
	}

	.profile-actions {
		margin-top: 1.5rem;
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
	}

	.profile-guest-actions {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
	}

	.profile-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2.6rem;
		padding: 0 1.25rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}

	.profile-btn:hover {
		transform: translateY(-1px);
	}

	.profile-btn:active {
		transform: scale(0.97);
	}

	.profile-btn-primary {
		background: var(--text-color, #111111);
		color: var(--page-bg, #ffffff);
	}

	.profile-btn-primary:active {
		background: color-mix(in oklab, var(--text-color, #111111) 88%, transparent);
	}

	.profile-btn-default {
		background: var(--btn-regular-bg, #f7f7f7);
		color: var(--text-color, #111111);
		border: 1px solid var(--surface-border, #dddddd);
	}

	.profile-btn-default:active {
		background: var(--btn-regular-bg-active, #ebebeb);
	}

	.profile-btn-danger {
		background: rgba(220, 38, 38, 0.1);
		color: #dc2626;
		border: 1px solid rgba(220, 38, 38, 0.25);
	}

	.profile-btn-danger:active {
		background: rgba(220, 38, 38, 0.2);
	}

	.profile-guest {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.profile-hint {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		color: color-mix(in oklab, var(--text-color, #111111) 68%, transparent);
	}

	:root.dark .profile-btn-primary {
		background: var(--text-color, #f5f7fb);
		color: var(--page-bg, #0f1218);
	}

	@media (max-width: 640px) {
		.profile-card {
			padding: 1.15rem;
			margin-top: 1rem;
		}

		.profile-avatar {
			width: 64px;
			height: 64px;
		}

		.profile-name {
			font-size: 1.25rem;
		}
	}
</style>
