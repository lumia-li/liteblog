---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { readSession } from "@utils/auth-server";
import { callAuthService } from "@utils/auth-service";
import AccountSettings from "@components/auth/AccountSettings.svelte";
import SecuritySettings from "@components/auth/SecuritySettings.svelte";

export const prerender = false;

const session = await readSession(Astro.request);
const user = session?.user ?? null;
const forwardedFor = Astro.request.headers.get("x-forwarded-for") || "";
const clientIp = (forwardedFor.split(",")[0] || Astro.request.headers.get("x-real-ip") || "").trim() || "未知 IP";
const loginAt = session?.issuedAt ?? Date.now();
// 邮箱注册账号的 id 是纯数字（MySQL 自增）；OAuth 用户 id 由各 Provider 签发
const isEmailAccount = Boolean(user && /^\d+$/.test(user.id));

// 实时读取后台（dbviewer）授予的身份组；cookie 里的 role 是登录时快照，仅作兜底
type IdentityBadge = { preset: string; text: string; tone: string };
let badge: IdentityBadge = { preset: "", text: "", tone: "" };
const badgeProvider = session
	? session.provider || (session.accessToken.startsWith("email-") ? "email" : "")
	: "";
if (user && badgeProvider) {
	try {
		const data = await callAuthService<{ badge?: IdentityBadge }>("/badge", {
			query: { provider: badgeProvider, userId: String(user.id) },
		});
		if (data.badge && data.badge.tone) badge = data.badge;
	} catch {
		/* 读取失败时回退 cookie role，不影响页面渲染 */
	}
}
const roleText = badge.text || (user?.role === "admin" ? "管理员" : "普通用户");
---

<MainGridLayout title="个人资料" description="用户个人资料页" showHero={false}>
	<div class:list={["profile-shell", !user && "profile-shell--guest"]}>
		{user ? (
			<>
				<aside class="profile-aside">
					<div class="profile-summary">
						<button
							type="button"
							class="profile-avatar-btn"
							class:list={[!isEmailAccount && "profile-avatar-btn--disabled"]}
							title={isEmailAccount ? "点击更换头像" : "该账号头像由对应平台管理，无法在此修改"}
							aria-label="更换头像"
							onclick={isEmailAccount
								? "window.dispatchEvent(new CustomEvent('avatar-change-request'))"
								: "window.dispatchEvent(new CustomEvent('avatar-change-denied'))"}
						>
							{user.avatar_url ? (
								<img src={user.avatar_url} alt={user.display_name || user.username} class="profile-avatar" />
							) : (
								<div class="profile-avatar profile-avatar-fallback">
									{(user.display_name || user.username).charAt(0).toUpperCase()}
								</div>
							)}
							<span class="profile-avatar-cam" aria-hidden="true">
								<svg viewBox="0 0 24 24"><path d="M12 15.2c1.77 0 3.2-1.43 3.2-3.2s-1.43-3.2-3.2-3.2-3.2 1.43-3.2 3.2 1.43 3.2 3.2 3.2zM9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z" fill="currentColor"/></svg>
							</span>
						</button>
						<div class="profile-name-row">
							<h1 class="profile-name">{user.display_name || user.username}</h1>
							{badge.text ? (
								<span class="profile-role" data-tone={badge.tone}>{badge.text}</span>
							) : ["1", "4"].includes(user.id) ? (
								<span class="profile-role profile-role-rainbow">
									{user.id === "1" ? "猫猫管理员" : "璃猫猫"}
								</span>
							) : (
								<span class="profile-role">{user.role === "admin" ? "管理员" : "普通用户"}</span>
							)}
						</div>
						<p class="profile-username">@{user.username}</p>
					</div>

					<nav class="profile-menu" aria-label="个人中心">
						<span class="profile-menu-indicator" aria-hidden="true"></span>
						<button type="button" class="profile-menu-item is-active" data-panel="panel-info" aria-pressed="true">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"/></svg>
							基本信息
						</button>
						{isEmailAccount && (
							<button type="button" class="profile-menu-item" data-panel="panel-account" aria-pressed="false">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" fill="currentColor"/></svg>
								账户设置
							</button>
						)}
						<button type="button" class="profile-menu-item" data-panel="panel-security" aria-pressed="false">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5.25 3.4 9.98 8 11 4.6-1.02 8-5.75 8-11V5l-8-3zm0 2.15 6 2.25V11c0 4.08-2.48 7.89-6 8.9C8.48 18.89 6 15.08 6 11V6.4l6-2.25z" fill="currentColor" /></svg>
							安全设置
						</button>
					</nav>

					<div class="profile-aside-foot">
						<a href="/" class="profile-foot-link">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="currentColor"/></svg>
							返回首页
						</a>
						<a href="/api/auth/logout" class="profile-foot-link profile-foot-link-danger">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4z" fill="currentColor"/></svg>
							退出登录
						</a>
					</div>
				</aside>

				<main class="profile-main">
					<div class="profile-panels" aria-live="polite">
					<section class="profile-panel is-active" id="panel-info" aria-hidden="false">
						<header class="panel-head">
							<h2 class="panel-title">基本信息</h2>
							<p class="panel-sub">账号的基础资料</p>
						</header>
						<div class="profile-fields">
							<div class="profile-field">
								<span class="profile-label">用户 ID</span>
								<span class="profile-value">{user.id}</span>
							</div>
							<div class="profile-field">
								<span class="profile-label">邮箱</span>
								<span class="profile-value">{user.email || "未设置"}</span>
							</div>
							<div class="profile-field">
								<span class="profile-label">用户名</span>
								<span class="profile-value">{user.username}</span>
							</div>
						</div>
					</section>
					{isEmailAccount && (
						<section class="profile-panel" id="panel-account" aria-hidden="true">
							<AccountSettings client:only="svelte" isEmailAccount={isEmailAccount} avatarUrl={user.avatar_url} email={user.email || ""} />
						</section>
					)}
					<section class="profile-panel" id="panel-security" aria-hidden="true">
						<SecuritySettings client:only="svelte" loginIp={clientIp} loginAt={loginAt} isEmailAccount={isEmailAccount} />
					</section>
					</div>
				</main>
			</>
		) : (
			<div class="profile-guest">
				<p class="profile-page-title">登录LiyueAccount账号</p>
				<div class="login-card">
					<aside class="brand-panel">
						<div class="brand-glow brand-glow-1" aria-hidden="true"></div>
						<div class="brand-glow brand-glow-2" aria-hidden="true"></div>
						<span class="brand-badge" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="currentColor"/></svg>
						</span>
						<h1 class="brand-title">liyue blog</h1>
						<p class="brand-subtitle">分享技术与生活的博客</p>
						<div class="brand-footer" aria-hidden="true">
							<span class="brand-dot"></span>
							<span class="brand-dot"></span>
							<span class="brand-dot"></span>
						</div>
					</aside>
					<section class="form-panel">
						<header class="panel-head">
							<h2 class="panel-title">登录</h2>
							<p class="panel-sub">登录后查看你的个人资料，或创建新账号</p>
						</header>
						<div class="login-buttons">
							<button
								type="button"
								class="login-capsule"
								onclick="window.dispatchEvent(new CustomEvent('open-auth-modal',{detail:{view:'login'}}))"
							>
								<svg class="capsule-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="currentColor"/></svg>
								<span>邮箱登录 / 注册</span>
							</button>
							<a class="login-capsule" href="/api/auth/login">
								<svg class="capsule-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z" fill="currentColor"/></svg>
								<span>Airliny 登录</span>
							</a>
							<a class="login-capsule" href="/api/auth/qq-login">
								<img class="capsule-logo" src="/qq-logo.png" alt="" width="20" height="20" />
								<span>QQ 登录</span>
							</a>
							<a class="login-capsule" href="/api/auth/google-login">
								<svg class="capsule-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
								<span>Google 登录</span>
							</a>
							<a class="login-capsule" href="/api/auth/github-login">
								<svg class="capsule-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" fill="currentColor"/></svg>
								<span>GitHub 登录</span>
							</a>
							<a class="login-capsule" href="/api/auth/microsoft-login">
								<svg class="capsule-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 2h9v9H2z" fill="#F25022"/><path d="M13 2h9v9h-9z" fill="#7FBA00"/><path d="M2 13h9v9H2z" fill="#00A4EF"/><path d="M13 13h9v9h-9z" fill="#FFB900"/></svg>
								<span>Microsoft 登录</span>
							</a>
						</div>
						<a href="/" class="guest-home">← 返回首页</a>
					</section>
				</div>
			</div>
		)}
	</div>
</MainGridLayout>

<script>
	declare global {
		interface Window {
			__profileSwupHooked?: boolean;
		}
	}

	// 过渡时长随高度差自适应（近似恒定速率、设上下限），整体放缓保证从容不突兀
	const profileMinDuration = 480;
	const profileMaxDuration = 900;
	const profileDurationPerPx = 1.4;
	const profileTransitionTimers = new WeakMap<HTMLElement, number>();

	function setupProfileTransitions() {
		document.querySelectorAll<HTMLElement>(".profile-menu").forEach((menu) => {
			const indicator = menu.querySelector<HTMLElement>(".profile-menu-indicator");
			if (!indicator) return;
			const updateIndicator = () => {
				const active = menu.querySelector<HTMLElement>(".profile-menu-item.is-active");
				if (!active) return;
				indicator.style.setProperty("--indicator-x", `${active.offsetLeft}px`);
				indicator.style.setProperty("--indicator-y", `${active.offsetTop}px`);
				indicator.style.setProperty("--indicator-width", `${active.offsetWidth}px`);
				indicator.style.setProperty("--indicator-height", `${active.offsetHeight}px`);
			};
			requestAnimationFrame(updateIndicator);
		});

		document.querySelectorAll<HTMLElement>(".profile-panels").forEach((panels) => {
			const active = panels.querySelector<HTMLElement>(".profile-panel.is-active");
			panels.querySelectorAll<HTMLElement>(".profile-panel").forEach((panel) => {
				panel.inert = !panel.classList.contains("is-active");
			});
			if (active && !panels.style.height) panels.style.height = `${active.offsetHeight}px`;
		});
	}

	function switchProfilePanel(item: HTMLElement) {
		const menu = item.closest<HTMLElement>(".profile-menu");
		const targetId = item.dataset.panel;
		if (!menu || !targetId || item.classList.contains("is-active")) return;
		const panels = menu.closest<HTMLElement>(".profile-shell")?.querySelector<HTMLElement>(".profile-panels");
		const target = panels?.querySelector<HTMLElement>(`#${CSS.escape(targetId)}`);
		const current = panels?.querySelector<HTMLElement>(".profile-panel.is-active");
		if (!panels || !target || !current) return;

		const items = [...menu.querySelectorAll<HTMLElement>(".profile-menu-item")];
		const direction = items.indexOf(item) >= items.indexOf(current) ? "forward" : "backward";
		const currentHeight = current.getBoundingClientRect().height;
		// 面板为 height:auto 的绝对定位，隐藏状态也能测到真实内容高度
		const targetHeight = target.getBoundingClientRect().height;
		// 时长随高度差自适应，保证切换的视觉速度一致
		const heightDelta = Math.abs(targetHeight - currentHeight);
		const duration = Math.round(
			Math.min(profileMaxDuration, Math.max(profileMinDuration, heightDelta * profileDurationPerPx))
		);
		panels.closest<HTMLElement>(".profile-shell")?.style.setProperty("--panel-duration", `${duration}ms`);
		const previousTimer = profileTransitionTimers.get(panels);
		if (previousTimer) window.clearTimeout(previousTimer);
		panels.querySelectorAll<HTMLElement>(".profile-panel.is-leaving").forEach((panel) => {
			panel.classList.remove("is-leaving", "is-forward", "is-backward");
		});
		panels.style.height = `${currentHeight}px`;
		current.classList.remove("is-active");
		current.classList.add("is-leaving", `is-${direction}`);
		target.classList.add("is-active", `is-${direction}`);
		current.inert = true;
		target.inert = false;
		current.setAttribute("aria-hidden", "true");
		target.setAttribute("aria-hidden", "false");
		menu.querySelectorAll<HTMLElement>(".profile-menu-item").forEach((button) => {
			const selected = button === item;
			button.classList.toggle("is-active", selected);
			button.setAttribute("aria-pressed", String(selected));
		});
		const indicator = menu.querySelector<HTMLElement>(".profile-menu-indicator");
		if (indicator) {
			indicator.style.setProperty("--indicator-x", `${item.offsetLeft}px`);
			indicator.style.setProperty("--indicator-y", `${item.offsetTop}px`);
			indicator.style.setProperty("--indicator-width", `${item.offsetWidth}px`);
			indicator.style.setProperty("--indicator-height", `${item.offsetHeight}px`);
		}
		requestAnimationFrame(() => {
			panels.style.height = `${targetHeight}px`;
		});
		const transitionTimer = window.setTimeout(() => {
			current.classList.remove("is-leaving", "is-forward", "is-backward");
			target.classList.remove("is-forward", "is-backward");
			panels.style.height = "auto";
		}, duration);
		profileTransitionTimers.set(panels, transitionTimer);
	}

	// 个人中心左侧菜单切换（事件委托，兼容 swup 路由切换）
	document.addEventListener("click", (event) => {
		const item = (event.target as Element)?.closest?.(".profile-menu-item") as HTMLElement | null;
		if (item) switchProfilePanel(item);
	});
	const bindProfileSwup = () => {
		if (window.swup?.hooks && !window.__profileSwupHooked) {
			window.__profileSwupHooked = true;
			window.swup.hooks.on("page:view", setupProfileTransitions);
		}
	};
	document.addEventListener("astro:page-load", setupProfileTransitions);
	document.addEventListener("swup:enable", bindProfileSwup);
	bindProfileSwup();
	window.addEventListener("resize", setupProfileTransitions);
	setupProfileTransitions();

	// 非邮箱账号点击头像：全局 toast 提示原因
	document.addEventListener("avatar-change-denied", () => {
		document.querySelectorAll(".avatar-toast").forEach((t) => t.remove());
		const toast = document.createElement("div");
		toast.className = "avatar-toast";
		toast.textContent = "该账号的头像由对应平台管理，无法在此修改";
		document.body.appendChild(toast);
		setTimeout(() => toast.remove(), 3000);
	});
</script>

<style is:global>
	.avatar-toast {
		position: fixed;
		left: 50%;
		bottom: 2.2rem;
		transform: translateX(-50%);
		z-index: 1200;
		padding: 0.65rem 1.1rem;
		border-radius: 12px;
		background: rgba(20, 24, 32, 0.92);
		color: #ffffff;
		font-size: 0.85rem;
		font-weight: 600;
		box-shadow: 0 12px 32px rgba(2, 6, 23, 0.35);
		animation: avatar-toast-in 0.2s ease;
		white-space: nowrap;
	}

	@keyframes avatar-toast-in {
		from {
			opacity: 0;
			transform: translate(-50%, 8px);
		}
		to {
			opacity: 1;
			transform: translate(-50%, 0);
		}
	}
</style>

<style>
	:root {
		--rc1: #00ff87;
		--rc2: #60efff;
		--rc3: #0061ff;
		--rc4: #ea00ff;
		--rc5: #ff1b6b;
	}

	@keyframes rainbow-move {
		0% { background-position: 0% 0%; }
		100% { background-position: 200% 0%; }
	}

	/* ── 外层：大圆角卡片容器 ── */
	.profile-shell {
		width: min(100%, 1000px);
		margin: 2.25rem auto 4rem;
		display: grid;
		grid-template-columns: 290px minmax(0, 1fr);
		border: 1px solid var(--surface-border, #dddddd);
		border-radius: 28px;
		overflow: hidden;
		background: var(--page-bg, #ffffff);
		box-shadow: 0 24px 70px rgba(2, 6, 23, 0.08);
	}

	.profile-shell--guest {
		grid-template-columns: 1fr;
		width: min(100%, 720px);
		border: none;
		background: transparent;
		box-shadow: none;
		overflow: visible;
	}

	/* ── 左侧栏 ── */
	.profile-aside {
		display: flex;
		flex-direction: column;
		gap: 1.9rem;
		padding: 2.1rem 1.35rem 1.5rem;
		background: var(--surface-bg, #f4f4f4);
		border-right: 1px solid var(--surface-border, #dddddd);
	}

	.profile-summary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.profile-avatar {
		width: 84px;
		height: 84px;
		border-radius: 22px;
		object-fit: cover;
		background: var(--btn-regular-bg, #f7f7f7);
		border: 1px solid var(--surface-border, #dddddd);
		-webkit-user-drag: none;
		user-drag: none;
		user-select: none;
	}

	/* 可点击头像（邮箱账号）：悬停显示相机角标 */
	.profile-avatar-btn {
		position: relative;
		display: inline-flex;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		border-radius: 22px;
	}

	.profile-avatar-btn .profile-avatar {
		transition: filter 0.15s ease, transform 0.15s ease;
	}

	.profile-avatar-btn:hover .profile-avatar {
		filter: brightness(0.82);
	}

	.profile-avatar-btn:active .profile-avatar {
		transform: scale(0.97);
	}

	.profile-avatar-cam {
		position: absolute;
		right: -6px;
		bottom: -6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 999px;
		background: linear-gradient(135deg, #ea6c0a, #f97316);
		color: #ffffff;
		box-shadow: 0 4px 12px rgba(249, 115, 22, 0.4);
		opacity: 0;
		transform: scale(0.7);
		transition: opacity 0.15s ease, transform 0.15s ease;
		pointer-events: none;
	}

	.profile-avatar-cam svg {
		width: 16px;
		height: 16px;
	}

	.profile-avatar-btn:hover .profile-avatar-cam,
	.profile-avatar-btn:focus-visible .profile-avatar-cam {
		opacity: 1;
		transform: scale(1);
	}

	/* 非邮箱账号：相机角标置灰，点击仅弹出提示 */
	.profile-avatar-btn--disabled .profile-avatar-cam {
		background: rgba(120, 128, 145, 0.75);
		box-shadow: none;
	}

	.profile-avatar-btn--disabled {
		cursor: not-allowed;
	}

	.profile-avatar-guest {
		border-radius: 999px;
		width: 96px;
		height: 96px;
	}

	.profile-avatar-fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 2.1rem;
		font-weight: 700;
		color: var(--text-color, #111111);
	}

	.profile-name-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.profile-name {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--text-color, #111111);
		user-select: none;
		word-break: break-word;
	}

	.profile-username {
		margin: 0;
		font-size: 0.88rem;
		color: color-mix(in oklab, var(--text-color, #111111) 62%, transparent);
		user-select: none;
		word-break: break-all;
	}

	.profile-role {
		display: inline-flex;
		width: fit-content;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		background: var(--btn-regular-bg, #f7f7f7);
		color: var(--text-color, #111111);
		border: 1px solid var(--surface-border, #dddddd);
		user-select: none;
		white-space: nowrap;
	}

	/* 后台身份组的皮肤（与导航栏徽章色调一致） */
	.profile-role[data-tone="admin"] {
		color: #7c3aed;
		border-color: rgba(124, 58, 237, 0.5);
		background: rgba(139, 92, 246, 0.1);
	}

	.profile-role[data-tone="vip"] {
		color: #d97706;
		border-color: rgba(217, 119, 6, 0.55);
		background: rgba(245, 158, 11, 0.12);
	}

	.profile-role[data-tone="mod"] {
		color: #0891b2;
		border-color: rgba(8, 145, 178, 0.5);
		background: rgba(8, 145, 178, 0.12);
	}

	.profile-role[data-tone="friend"] {
		color: #db2777;
		border-color: rgba(219, 39, 119, 0.5);
		background: rgba(219, 39, 119, 0.12);
	}

	.profile-role[data-tone="test"] {
		color: #ca8a04;
		border-color: rgba(202, 138, 4, 0.5);
		background: rgba(234, 179, 8, 0.14);
	}

	.profile-role[data-tone="ban"] {
		color: #dc2626;
		border-color: rgba(220, 38, 38, 0.5);
		background: rgba(220, 38, 38, 0.12);
	}

	:root.dark .profile-role[data-tone="admin"] { color: #a78bfa; }
	:root.dark .profile-role[data-tone="ban"] { color: #f87171; }
	:root.dark .profile-role[data-tone="vip"] { color: #fbbf24; }
	:root.dark .profile-role[data-tone="mod"] { color: #22d3ee; }

	.profile-role-rainbow {
		position: relative;
		background: #dbeafe;
		color: #1e40af;
		z-index: 0;
	}

	.profile-role-rainbow::before {
		content: '';
		position: absolute;
		inset: -2px;
		z-index: -1;
		border-radius: inherit;
		padding: 2px;
		background: linear-gradient(90deg, var(--rc1), var(--rc5), var(--rc3), var(--rc4), var(--rc2), var(--rc1));
		background-size: 200% 100%;
		animation: rainbow-move 4s linear infinite;
		-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}

	.profile-role-rainbow::after {
		content: '';
		position: absolute;
		bottom: -35%;
		left: 5%;
		width: 90%;
		height: 35%;
		z-index: -1;
		background: linear-gradient(90deg, var(--rc1), var(--rc5), var(--rc3), var(--rc4), var(--rc2), var(--rc1));
		background-size: 200% 100%;
		filter: blur(10px);
		opacity: 0.7;
		border-radius: 999px;
		animation: rainbow-move 4s linear infinite;
		pointer-events: none;
	}

	:root.dark .profile-role-rainbow {
		background: rgba(59, 130, 246, 0.2);
		color: #bfdbfe;
	}

	/* ── 菜单 ── */
	.profile-menu {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.profile-menu-indicator {
		position: absolute;
		z-index: 0;
		left: 0;
		top: 0;
		width: var(--indicator-width, 0px);
		height: var(--indicator-height, 0px);
		border-radius: 14px;
		background: linear-gradient(135deg, rgba(234, 108, 10, 0.14), rgba(249, 115, 22, 0.25));
		box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.2), 0 6px 18px rgba(249, 115, 22, 0.12);
		transform: translate3d(var(--indicator-x, 0px), var(--indicator-y, 0px), 0);
		pointer-events: none;
	}

	.profile-menu-indicator::before,
	.profile-menu-indicator::after {
		content: "";
		position: absolute;
		top: 50%;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: rgba(249, 115, 22, 0.28);
		filter: blur(5px);
		transform: translateY(-50%);
	}

	.profile-menu-indicator::before { left: -5px; }
	.profile-menu-indicator::after { right: -5px; }

	.profile-menu-item {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		width: 100%;
		padding: 0.7rem 0.95rem;
		border: none;
		border-radius: 12px;
		background: transparent;
		color: color-mix(in oklab, var(--text-color, #111111) 78%, transparent);
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		text-align: left;
		transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
	}

	.profile-menu-item svg {
		width: 19px;
		height: 19px;
		opacity: 0.7;
		flex-shrink: 0;
		transition: opacity 0.15s ease;
	}

	.profile-menu-item:hover {
		background: rgba(120, 128, 145, 0.1);
		color: var(--text-color, #111111);
	}

	.profile-menu-item.is-active {
		background: transparent;
		color: #f97316;
		box-shadow: none;
	}

	.profile-menu-item.is-active svg {
		opacity: 1;
		color: #f97316;
	}

	.profile-aside-foot {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--surface-border, #dddddd);
	}

	.profile-foot-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.55rem 0.8rem;
		border-radius: 10px;
		color: color-mix(in oklab, var(--text-color, #111111) 72%, transparent);
		font-size: 0.84rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.profile-foot-link svg {
		width: 17px;
		height: 17px;
	}

	.profile-foot-link:hover {
		background: rgba(120, 128, 145, 0.1);
		color: var(--text-color, #111111);
	}

	.profile-foot-link-danger {
		color: #dc2626;
	}

	.profile-foot-link-danger:hover {
		background: rgba(220, 38, 38, 0.08);
		color: #dc2626;
	}

	/* ── 右侧内容 ── */
	.profile-main {
		padding: 2.2rem 2.3rem 2.6rem;
		min-width: 0;
	}

	.profile-panels {
		position: relative;
		overflow: hidden;
		min-height: 8rem;
	}

	.profile-panel {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(0, 12px, 0) scale(0.985);
		filter: blur(2px);
		pointer-events: none;
	}

	.profile-panel.is-active {
		position: relative;
		opacity: 1;
		visibility: visible;
		transform: translate3d(0, 0, 0) scale(1);
		filter: blur(0);
		pointer-events: auto;
	}

	.profile-panel.is-leaving {
		position: absolute;
		visibility: visible;
		opacity: 0;
		transform: translate3d(0, -10px, 0) scale(0.985);
		filter: blur(2px);
	}

	.profile-panel.is-active.is-forward { transform: translate3d(0, 0, 0) scale(1); }
	.profile-panel.is-active.is-backward { transform: translate3d(0, 0, 0) scale(1); }
	.profile-panel.is-leaving.is-forward { transform: translate3d(-18px, -8px, 0) scale(0.985); }
	.profile-panel.is-leaving.is-backward { transform: translate3d(18px, -8px, 0) scale(0.985); }

	/* 桌面端：内容过长时限高整卡，右侧改为卡片内滚动（鼠标滚轮）；内容不长时保持自然高度 */
	@media (min-width: 901px) {
		.profile-shell:not(.profile-shell--guest) {
			max-height: min(720px, calc(100vh - 8rem));
			grid-template-rows: minmax(0, 1fr);
		}

		.profile-main {
			min-height: 0;
			overflow-y: auto;
			overscroll-behavior: contain;
			scrollbar-width: thin;
			scrollbar-color: rgba(120, 128, 145, 0.45) transparent;
		}

		.profile-aside {
			min-height: 0;
			overflow-y: auto;
			scrollbar-width: thin;
			scrollbar-color: rgba(120, 128, 145, 0.45) transparent;
		}

		.profile-main::-webkit-scrollbar {
			width: 8px;
		}

		.profile-main::-webkit-scrollbar-track {
			background: transparent;
		}

		.profile-main::-webkit-scrollbar-thumb {
			border-radius: 999px;
			background: rgba(120, 128, 145, 0.35);
		}

		.profile-main::-webkit-scrollbar-thumb:hover {
			background: rgba(120, 128, 145, 0.55);
		}

		:root.dark .profile-main {
			scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
		}

		:root.dark .profile-main::-webkit-scrollbar-thumb {
			background: rgba(255, 255, 255, 0.22);
		}

		:root.dark .profile-main::-webkit-scrollbar-thumb:hover {
			background: rgba(255, 255, 255, 0.38);
		}
	}

	.panel-head {
		margin-bottom: 1.4rem;
	}

	.panel-title {
		margin: 0;
		font-size: 1.18rem;
		font-weight: 800;
		color: var(--text-color, #111111);
	}

	.panel-sub {
		margin: 0.3rem 0 0;
		font-size: 0.82rem;
		color: color-mix(in oklab, var(--text-color, #111111) 62%, transparent);
	}

	.profile-fields {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.profile-field {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 1.15rem;
		border-radius: 14px;
		background: var(--card-bg, #f5f5f5);
		border: 1px solid var(--surface-border, #dddddd);
		transition: border-color 0.15s ease;
	}

	.profile-field:hover {
		border-color: color-mix(in oklab, var(--surface-border, #dddddd) 60%, #f97316);
	}

	.profile-label {
		flex-shrink: 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: color-mix(in oklab, var(--text-color, #111111) 70%, transparent);
	}

	.profile-value {
		font-size: 0.92rem;
		font-weight: 650;
		color: var(--text-color, #111111);
		word-break: break-all;
		text-align: right;
	}

	/* 内嵌的账户设置组件（AccountSettings.svelte）标题与主题统一 */
	:global(.account-settings .profile-section-title) {
		margin: 0 0 1.1rem;
		font-size: 1.18rem;
		font-weight: 800;
		color: var(--text-color, #111111);
	}

	/* ── 游客视图 ── */
	.profile-guest {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
		padding: 3rem 2rem;
		text-align: center;
	}

	/* ── 未登录：登录双面板卡片 ── */
	.profile-page-title {
		margin: 0 0 0.9rem;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--text-color, #111111);
		text-align: center;
	}

	.login-card {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		width: min(720px, 100%);
		margin: 0 auto;
		border-radius: 20px;
		overflow: hidden;
		border: 1px solid rgba(228, 232, 240, 0.9);
		background: #ffffff;
		box-shadow: 0 28px 72px rgba(2, 6, 23, 0.18);
	}

	.brand-panel {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 2.5rem 1.5rem;
		background: linear-gradient(160deg, #f4f5f7 0%, #e9ebef 100%);
		overflow: hidden;
	}

	.brand-glow {
		position: absolute;
		border-radius: 999px;
		filter: blur(56px);
		opacity: 0.5;
		pointer-events: none;
	}

	.brand-glow-1 {
		width: 220px;
		height: 220px;
		top: -60px;
		right: -60px;
		background: rgba(249, 115, 22, 0.22);
	}

	.brand-glow-2 {
		width: 180px;
		height: 180px;
		bottom: -50px;
		left: -50px;
		background: rgba(99, 102, 241, 0.16);
	}

	.brand-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 13px;
		background: linear-gradient(135deg, #f97316, #fb923c);
		color: #ffffff;
		box-shadow: 0 8px 20px rgba(249, 115, 22, 0.35);
		margin-bottom: 0.4rem;
	}

	.brand-badge svg {
		width: 21px;
		height: 21px;
	}

	.brand-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #1d2838;
	}

	.brand-subtitle {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.7;
		color: #6b7280;
	}

	.brand-footer {
		display: flex;
		gap: 7px;
		margin-top: 1.6rem;
	}

	.brand-dot {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: #f97316;
		opacity: 0.85;
	}

	.brand-dot:nth-child(2) {
		opacity: 0.45;
	}

	.brand-dot:nth-child(3) {
		opacity: 0.2;
	}

	.login-card .form-panel {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.1rem;
		min-height: 420px;
		padding: 2.5rem 2.4rem;
		background: #ffffff;
	}

	.login-buttons {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
	}

	.login-capsule {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		width: 100%;
		padding: 0.66rem 0.8rem;
		border-radius: 999px;
		border: 1.5px solid #e2e5ea;
		background: #f4f5f7;
		color: #1d2838;
		font-size: 0.88rem;
		font-weight: 600;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease,
			transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
		box-shadow: 0 1px 2px rgba(2, 6, 23, 0.05);
	}

	.login-capsule:hover {
		border-color: #f97316;
		background: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 6px 14px rgba(249, 115, 22, 0.16);
	}

	.login-capsule:active {
		transform: scale(0.94);
		box-shadow: 0 1px 2px rgba(2, 6, 23, 0.1);
		transition-duration: 0.07s;
	}

	.capsule-logo {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
	}

	.guest-home {
		align-self: center;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-color, #111111);
		opacity: 0.65;
		text-decoration: none;
		transition: color 0.15s ease, opacity 0.15s ease;
	}

	.guest-home:hover {
		color: #f97316;
		opacity: 1;
	}

	:root.dark .login-card {
		border-color: rgba(63, 70, 84, 0.85);
		background: #191e26;
	}

	:root.dark .brand-panel {
		background: linear-gradient(160deg, #232936 0%, #1b202b 100%);
	}

	:root.dark .brand-title {
		color: #e8ebf1;
	}

	:root.dark .brand-subtitle {
		color: #9aa2b1;
	}

	:root.dark .login-card .form-panel {
		background: #191e26;
	}

	:root.dark .login-capsule {
		border-color: #333b49;
		background: #212733;
		color: #e8ebf1;
	}

	:root.dark .login-capsule:hover {
		border-color: #fb923c;
		background: #232a37;
	}

	@media (max-width: 760px) {
		.login-card {
			grid-template-columns: 1fr;
		}

		.brand-panel {
			display: none;
		}

		.login-card .form-panel {
			min-height: 360px;
			padding: 2rem 1.6rem 1.8rem;
		}

		.login-buttons {
			gap: 0.5rem;
		}

		.login-capsule {
			padding: 0.6rem 0.5rem;
			font-size: 0.84rem;
		}
	}

	.profile-hint {
		margin: 0 0 0.6rem;
		font-size: 0.9rem;
		color: color-mix(in oklab, var(--text-color, #111111) 68%, transparent);
	}

	.profile-guest-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		justify-content: center;
	}

	.profile-guest-oauth {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin-top: 0.15rem;
	}

	.profile-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2.6rem;
		padding: 0 1.4rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 700;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease,
